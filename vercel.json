{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm -w web run build",
  "installCommand": "npm install --include=dev --ignore-scripts",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
}
